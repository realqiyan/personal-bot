{
  "name": "personal-bot",
  "version": "0.2.13",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/realqiyan/personal-bot.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "description": "A personal assistant connecting knowledge, research, and action for Pi, DeepSeek Harness, and Claude Code.",
  "type": "module",
  "bin": {
    "pbot": "./bin/pbot.mjs"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./src/pbot.ts"
    ],
    "skills": [],
    "prompts": [],
    "themes": []
  },
  "dsh": {
    "bundle": {
      "patch": "./resources/dsh/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-file-upload"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./lib/dsh.d.ts",
      "default": "./lib/dsh.js"
    },
    "./dsh": {
      "types": "./lib/dsh.d.ts",
      "default": "./lib/dsh.js"
    },
    "./client": {
      "types": "./lib/ui/dsh/index.d.ts",
      "default": "./lib/client.js"
    },
    "./*": "./*"
  },
  "files": [
    "npm-shrinkwrap.json",
    "bin",
    "lib",
    "src",
    "resources",
    ".claude-plugin/plugin.json",
    ".claude-plugin/marketplace.json",
    "hooks/hooks.json",
    "scripts/setup-python.py",
    "scripts/README.md",
    "python/requirements.lock",
    "python/README.md",
    "README.md",
    "README.zh-CN.md",
    "CONTEXT.md",
    "docs"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.2-rc.1"
  },
  "scripts": {
    "check": "tsc --noEmit && npm run check:dependencies",
    "check:dependencies": "depcruise --config .dependency-cruiser.cjs src",
    "build": "node scripts/clean-dist.mjs && tsc && npm run build:cli && npm run build:dsh && npm run build:claude",
    "build:cli": "node scripts/build-cli.mjs",
    "build:dsh": "node scripts/build-dsh.mjs",
    "build:claude": "node scripts/build-claude.mjs",
    "test": "npm run build && node --test --test-concurrency=1 tests/*/*.test.mjs",
    "test:smoke": "npm run build && node --test --test-concurrency=1 tests/smoke/*.test.mjs",
    "test:e2e": "npm run build && node --test --test-concurrency=1 tests/e2e/*.test.mjs",
    "test:e2e:acp": "npm run build && node --test --test-concurrency=1 tests/e2e/acp-defaults.e2e.mjs",
    "prepack": "npm run check && npm run build:cli && npm run build:dsh && npm run build:claude"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": "*",
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-agent-preset-registry": "*",
    "@deepseek-ai/dsh-api-remotes": "*",
    "@deepseek-ai/dsh-attachment": "*",
    "@deepseek-ai/dsh-client-file-upload": "*",
    "@deepseek-ai/dsh-client-ui-commands": "*",
    "@deepseek-ai/dsh-commands": "*",
    "@deepseek-ai/dsh-fs": "*",
    "@deepseek-ai/dsh-fs-patch": "*",
    "@deepseek-ai/dsh-home-paths": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-scope": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-session-persistence": "*",
    "@deepseek-ai/dsh-session-query": "*",
    "@deepseek-ai/dsh-skill": "*",
    "@deepseek-ai/dsh-skill-filesystem": "*",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-tool-executor-ptc": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-typert-protocol": "*",
    "@deepseek-ai/dsh-typert-registry": "*",
    "@deepseek-ai/dsh-user-approval": "*",
    "@deepseek-ai/dsh-working-directory": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
